# Copy to .bot.env and fill in. NEVER commit, NEVER share.
# chmod 600 .bot.env

DISCORD_TOKEN=paste-token-here
DST_CONTROL_CHANNEL_ID=1500808656751693937

# Optional but recommended: register slash commands to a single guild for instant
# updates (vs. global which can take up to 1 hour). Get the ID by enabling
# Developer Mode in Discord and right-clicking your server icon > Copy Server ID.
DST_GUILD_ID=

# Webhook URL for event notifications (server start/stop/switch/destroy).
# Create at: Discord → #dst-control → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=
