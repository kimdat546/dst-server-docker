return {
{{ if ne (getenv "DST_SERVER_MOD_SETUP") "" }}
  {{ range $i, $mod := (strings.Split "," (getenv "DST_SERVER_MOD_SETUP")) }}{{ if gt $i 0 }},{{ end }}
  ["workshop-{{ strings.TrimSpace $mod }}"] = {
    enabled = true,
    configuration_options = { {{ if ne (getenv (print "DST_WORKSHOP_" (strings.TrimSpace $mod))) "" }}
      {{ getenv (print "DST_WORKSHOP_" (strings.TrimSpace $mod)) }}
    {{ end }} }
  }{{ end }}
{{ end }}

{{ if ne (getenv "DST_MOD_OVERRIDES_RAW") "" }}
  {{ getenv "DST_MOD_OVERRIDES_RAW" }}
{{ end }}
}
