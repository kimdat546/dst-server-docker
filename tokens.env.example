# Mẫu cho tokens.env — copy thành `tokens.env` rồi điền token thật.
# tokens.env bị .gitignore bỏ qua nên KHÔNG bao giờ vào git (repo này public).
#
# File nằm ở gốc repo → không bị `git checkout` đụng tới → một kho token
# dùng chung cho MỌI world (mọi nhánh).
#
# Lấy token ở đâu: https://accounts.klei.com → Games → Don't Starve Together
# → Servers → Add New Server → Configure Server → Copy Token.
#
# Đừng sửa tay, dùng lệnh cho chắc:
#   dst token add chinh 'pds-...'     lưu thêm một token
#   dst token list                    xem có những token nào, cái nào đang dùng
#   dst token use chinh               chuyển sang dùng nó
#   dst restart --fresh               áp vào server đang chạy
#
# Đổi token KHÔNG ảnh hưởng world, nhân vật hay quyền admin — token chỉ nói
# server đang được host dưới tài khoản Klei nào.

TOKEN_CHINH=pds-g^KU_thay-bang-token-that=
TOKEN_PHU=pds-g^KU_thay-bang-token-khac=

ACTIVE_TOKEN=CHINH
