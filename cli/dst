#!/usr/bin/env bash
# dst — branch-as-world manager. Switches DST worlds by checking out git branches
# and syncing save data with Google Drive via tar.gz + rclone.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
LOCK_FILE="/run/lock/dst.lock"
JSON=0
CLI="$ROOT/cli"
COMPOSE_FILE="$CLI/compose.yml"
EXTRACT="$CLI/extract-env.py"
SERVER_COMPOSE="$ROOT/server/docker-compose.yml"
BOT_DIR="$ROOT/bot"
STATE_FILE="$ROOT/.dst-current"
ENV_FILE="$ROOT/.world.env"
# Kho token Klei. Nằm ở ROOT và bị .gitignore bỏ qua → KHÔNG bao giờ vào git
# (repo này public), và sống sót qua mọi `git checkout` / `dst switch`, nên là
# MỘT kho dùng chung cho tất cả world. Xem `dst token`.
TOKENS_FILE="$ROOT/tokens.env"
REMOTE="${DST_REMOTE:-dst-storage:dst-worlds}"

NON_WORLD_BRANCHES_RE='^(main|master|HEAD)$'

# Discord webhook (optional) — set DISCORD_WEBHOOK_URL in .bot.env or environment
WEBHOOK_URL="${DISCORD_WEBHOOK_URL:-}"
_load_webhook() {
  local env_file="$BOT_DIR/.bot.env"
  if [ -z "$WEBHOOK_URL" ] && [ -f "$env_file" ]; then
    WEBHOOK_URL="$(grep -m1 '^DISCORD_WEBHOOK_URL=' "$env_file" 2>/dev/null | cut -d= -f2- | tr -d '"' | tr -d "'")" || true
  fi
}
_load_webhook

notify() {
  # notify <color_hex> <title> [body]
  [ -z "$WEBHOOK_URL" ] && return 0
  local color="$1" title="$2" body="${3:-}"
  local world; world="$(current_state 2>/dev/null || echo '')"
  local payload
  payload="$(printf '{"embeds":[{"title":"%s","description":"%s","color":%d,"footer":{"text":"world: %s"}}]}' \
    "$title" "$body" "$color" "${world:-?}")"
  curl -sfS -X POST -H "Content-Type: application/json" -d "$payload" "$WEBHOOK_URL" >/dev/null 2>&1 || true
}

# Paths excluded from the tar archive (mods, backups, logs — re-downloaded on start)
TAR_EXCLUDES=(
  --exclude="data/Master/server/general/*/backup"
  --exclude="data/Caves/server/general/*/backup"
  --exclude="data/*/server/general/*/server_log.txt*"
  --exclude="data/*/server/general/*/server_chat_log.txt*"
  --exclude="data/*/mods"
  --exclude="data/*/ugc_mods"
  --exclude="data/*/Agreements"
  --exclude="data/*/steamcmd"
  --exclude="data/*/steamapps"
)

c_red()    { printf "\033[31m%s\033[0m\n" "$*"; }
c_green()  { printf "\033[32m%s\033[0m\n" "$*"; }
c_yellow() { printf "\033[33m%s\033[0m\n" "$*"; }
c_blue()   { printf "\033[34m%s\033[0m\n" "$*"; }

git_q()   { git -C "$ROOT" "$@"; }
in_repo() { [ -d "$ROOT/.git" ] || { c_red "Not a git repo: $ROOT"; exit 1; }; }

current_branch() { git_q rev-parse --abbrev-ref HEAD 2>/dev/null; }
current_state()  { [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo ""; }

require_clean_tree() {
  if ! git_q diff --quiet || ! git_q diff --cached --quiet; then
    c_red "Working tree has uncommitted changes. Commit, stash, or discard first."
    git_q status --short
    exit 1
  fi
}

require_rclone() {
  command -v rclone >/dev/null 2>&1 || { c_red "rclone not installed (apt install rclone)"; exit 1; }
  rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:" || {
    c_red "rclone remote '${REMOTE%%:*}' not configured. Run: rclone config"; exit 1; }
}

is_running() {
  local b="${1:-$(current_state)}"
  [ -n "$b" ] && docker ps --format '{{.Names}}' | grep -q "^dst-master-${b}$"
}

compose() {
  local b="$1"; shift
  ( cd "$CLI" && DST_BRANCH="$b" docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@" )
}

# Liệt kê người chơi đang online, đọc từ log của container master.
# Hai mốc đã kiểm chứng trong server_log:
#   vào : "Client authenticated: (KU_xxx) <tên>"
#   ra  : "[Shard] (KU_xxx) disconnected from Master(1)"
# Lấy trạng thái CUỐI CÙNG của từng userid → ai còn ở trạng thái "vào" là online.
online_players() {
  local b="$1"
  local container="dst-master-${b}"
  local started_at
  started_at="$(docker inspect -f '{{.State.StartedAt}}' "$container" 2>/dev/null || true)"
  [ -n "$started_at" ] || return 0
  docker logs --since "$started_at" "$container" 2>&1 | awk '
    /Client authenticated: \(KU_/ {
      match($0, /KU_[A-Za-z0-9_-]+/); u = substr($0, RSTART, RLENGTH)
      n = $0; sub(/.*\) /, "", n); gsub(/[[:space:]]+$/, "", n)
      state[u] = 1; name[u] = n
    }
    /\(KU_[A-Za-z0-9_-]+\) disconnected/ {
      match($0, /KU_[A-Za-z0-9_-]+/); u = substr($0, RSTART, RLENGTH)
      state[u] = 0
    }
    END { for (u in state) if (state[u]) printf "%s (%s)\n", (name[u] ? name[u] : "?"), u }
  '
}

remote_archive() { echo "$REMOTE/$1.tar.gz"; }  # e.g. dst-storage:dst-worlds/myth-words.tar.gz

# Wait for the master container to log [SyncWorldSettings], which only fires
# after the caves shard has connected and world generation is past the
# cross-shard sync — i.e. the game is actually accepting players.
# Falls back gracefully if the marker doesn't appear within timeout.
wait_for_ready() {
  local b="$1"
  local container="dst-master-${b}"
  local started_at
  started_at="$(docker inspect -f '{{.State.StartedAt}}' "$container" 2>/dev/null || true)"
  if [ -z "$started_at" ]; then
    c_yellow "Cannot detect ready: $container not running"
    return 1
  fi

  local timeout="${DST_READY_TIMEOUT:-180}"
  local interval=3
  local elapsed=0
  c_blue "Waiting for cross-shard sync (timeout ${timeout}s)…"
  while [ "$elapsed" -lt "$timeout" ]; do
    if docker logs --since "$started_at" "$container" 2>&1 | grep -q '\[SyncWorldSettings\]'; then
      c_green "Game is ready (${elapsed}s)."
      return 0
    fi
    sleep "$interval"
    elapsed=$((elapsed + interval))
  done
  c_yellow "Timeout (${timeout}s) — server may still be initializing. Check 'docker logs $container'."
  return 1
}

# Drop orphan named volumes from old/manual setups. Safe whenever save data is on Drive,
# since current containers use bind mounts to ./data/, not these volumes.
clear_orphan_volumes() {
  local volumes
  volumes="$(docker volume ls -q 2>/dev/null | grep -E '^(dst-server-docker_)?dst-(master|caves)-data-' || true)"
  if [ -n "$volumes" ]; then
    local removed
    removed="$(echo "$volumes" | xargs docker volume rm 2>/dev/null || true)"
    [ -n "$removed" ] && c_green "Cleared orphan volumes: $(echo "$removed" | tr '\n' ' ')"
  fi
}

# ---- Kho token (tokens.env) ------------------------------------------------
# Định dạng:  TOKEN_<TÊN>=pds-...      (một dòng mỗi token)
#             ACTIVE_TOKEN=<TÊN>       (token đang dùng)

token_names() {
  [ -f "$TOKENS_FILE" ] || return 0
  grep -oE '^TOKEN_[A-Za-z0-9_]+' "$TOKENS_FILE" | sed 's/^TOKEN_//'
}

active_token_name() {
  [ -f "$TOKENS_FILE" ] || return 0
  sed -n 's/^ACTIVE_TOKEN=//p' "$TOKENS_FILE" | tail -1
}

token_value() {   # $1 = tên
  [ -f "$TOKENS_FILE" ] || return 0
  sed -n "s/^TOKEN_$1=//p" "$TOKENS_FILE" | tail -1
}

mask_token() {    # chỉ in đầu/đuôi, đủ để nhận ra mà không lộ
  local v="$1"
  [ ${#v} -gt 16 ] && printf '%s…%s' "${v:0:10}" "${v: -4}" || printf '%s' '(quá ngắn?)'
}

cmd_init() {
  in_repo
  local branch; branch="$(current_branch)"
  [ -f "$SERVER_COMPOSE" ] || { c_red "No server/docker-compose.yml on branch $branch"; exit 1; }
  python3 "$EXTRACT" "$SERVER_COMPOSE" > "$ENV_FILE"
  echo "DST_BRANCH=$branch" >> "$ENV_FILE"

  # Token lấy từ tokens.env và LUÔN thắng giá trị (nếu có) trong compose của
  # nhánh. Nhờ vậy nhánh cũ còn hardcode token vẫn chạy đúng token đang chọn,
  # không phải sửa từng nhánh.
  local tname tval
  tname="$(active_token_name)"
  if [ -n "$tname" ]; then
    tval="$(token_value "$tname")"
    if [ -z "$tval" ]; then
      c_red "tokens.env: ACTIVE_TOKEN=$tname nhưng không có dòng TOKEN_$tname="
      exit 1
    fi
    sed -i '/^DST_CLUSTER_TOKEN=/d' "$ENV_FILE"
    printf 'DST_CLUSTER_TOKEN=%s\n' "$tval" >> "$ENV_FILE"
    c_green "Token: $tname ($(mask_token "$tval"))"
  elif grep -q '^DST_CLUSTER_TOKEN=' "$ENV_FILE"; then
    c_yellow "Chưa có tokens.env — đang dùng token hardcode trong compose của nhánh."
    c_yellow "Chuyển sang kho token:  dst token add <tên> '<pds-...>'"
  else
    c_red "Không tìm thấy token ở đâu cả — server sẽ không khởi động được."
    c_yellow "Thêm bằng:  dst token add <tên> '<pds-...>'"
    exit 1
  fi
  mkdir -p "$ROOT/data/Master" "$ROOT/data/Caves"
  c_green "Wrote $ENV_FILE for branch '$branch'."
}

cmd_token() {
  in_repo
  local action="${1:-list}" name="${2:-}" value="${3:-}"
  case "$action" in
    list|ls)
      [ -f "$TOKENS_FILE" ] || { c_yellow "Chưa có $TOKENS_FILE."; c_yellow "Thêm:  dst token add <tên> '<pds-...>'"; return; }
      local active n v; active="$(active_token_name)"
      for n in $(token_names); do
        v="$(token_value "$n")"
        if [ "$n" = "$active" ]; then c_green "  * $n	$(mask_token "$v")	← đang dùng"
        else                          echo   "    $n	$(mask_token "$v")"; fi
      done
      ;;
    use)
      [ -n "$name" ] || { c_red "usage: dst token use <tên>"; exit 1; }
      [ -n "$(token_value "$name")" ] || { c_red "Không có token tên '$name'."; cmd_token list; exit 1; }
      if grep -q '^ACTIVE_TOKEN=' "$TOKENS_FILE"; then
        sed -i "s|^ACTIVE_TOKEN=.*|ACTIVE_TOKEN=$name|" "$TOKENS_FILE"
      else
        printf 'ACTIVE_TOKEN=%s\n' "$name" >> "$TOKENS_FILE"
      fi
      cmd_init
      is_running && c_yellow "Áp dụng vào server đang chạy:  dst restart --fresh" || true
      ;;
    add)
      [ -n "$name" ] && [ -n "$value" ] || { c_red "usage: dst token add <tên> '<pds-...>'"; exit 1; }
      case "$name"  in *[!A-Za-z0-9_]*) c_red "Tên chỉ được gồm chữ, số, gạch dưới."; exit 1 ;; esac
      case "$value" in pds-*) : ;; *) c_yellow "Cảnh báo: token Klei thường bắt đầu bằng 'pds-'." ;; esac
      touch "$TOKENS_FILE"; chmod 600 "$TOKENS_FILE"
      sed -i "/^TOKEN_$name=/d" "$TOKENS_FILE"
      printf 'TOKEN_%s=%s\n' "$name" "$value" >> "$TOKENS_FILE"
      c_green "Đã lưu token '$name' vào $TOKENS_FILE (nằm ngoài git)."
      if [ -z "$(active_token_name)" ]; then
        printf 'ACTIVE_TOKEN=%s\n' "$name" >> "$TOKENS_FILE"
        c_green "Đây là token đầu tiên → đặt luôn làm token đang dùng."
      else
        c_yellow "Chuyển sang dùng nó:  dst token use $name"
      fi
      ;;
    rm|remove)
      [ -n "$name" ] || { c_red "usage: dst token rm <tên>"; exit 1; }
      [ "$name" = "$(active_token_name)" ] && { c_red "'$name' đang được dùng — đổi sang token khác trước."; exit 1; }
      sed -i "/^TOKEN_$name=/d" "$TOKENS_FILE"
      c_green "Đã xoá token '$name'."
      ;;
    *) c_red "usage: dst token <list|use|add|rm> [tên] [giá trị]"; exit 1 ;;
  esac
}

cmd_list() {
  in_repo
  local active; active="$(current_state)"
  local cur_branch; cur_branch="$(current_branch)"

  if [ "$JSON" = 1 ]; then
    local first=1
    printf '{"current_branch":"%s","active_world":"%s","branches":[' "$cur_branch" "$active"
    while read -r b; do
      [[ "$b" =~ $NON_WORLD_BRANCHES_RE ]] && continue
      local running=false; is_running "$b" && running=true
      [ $first -eq 1 ] || printf ','
      first=0
      printf '{"name":"%s","running":%s,"checked_out":%s,"active":%s}' \
        "$b" "$running" "$([ "$b" = "$cur_branch" ] && echo true || echo false)" \
        "$([ "$b" = "$active" ] && echo true || echo false)"
    done < <(git_q for-each-ref --format='%(refname:short)' refs/heads/)
    printf '],"remote":['
    if command -v rclone >/dev/null 2>&1 && rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
      first=1
      while read -r r; do
        r="${r%.tar.gz}"; [ -z "$r" ] && continue
        [ $first -eq 1 ] || printf ','
        first=0
        printf '"%s"' "$r"
      done < <(rclone lsf "$REMOTE" --include "*.tar.gz" 2>/dev/null)
    fi
    printf ']}\n'
    return
  fi

  c_blue "Branches (worlds):"
  while read -r b; do
    [[ "$b" =~ $NON_WORLD_BRANCHES_RE ]] && continue
    local marks=""
    [ "$b" = "$cur_branch" ] && marks="$marks $(c_yellow '[checked-out]')"
    [ "$b" = "$active" ]     && marks="$marks $(c_green '[active]')"
    is_running "$b"           && marks="$marks $(c_green '[running]')"
    printf "  - %s%s\n" "$b" "$marks"
  done < <(git_q for-each-ref --format='%(refname:short)' refs/heads/)

  if command -v rclone >/dev/null 2>&1 && rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
    c_blue "\nCloud saves ($REMOTE):"
    rclone lsf "$REMOTE" --include "*.tar.gz" 2>/dev/null \
      | sed 's/\.tar\.gz$//; s/^/  - /' || c_yellow "  (none)"
  fi
}

cmd_current() { local s; s="$(current_state)"; [ -n "$s" ] && echo "$s" || c_yellow "(none)"; }

cmd_push() {
  local b="${1:-$(current_state)}"
  [ -n "$b" ] || { c_red "no active world"; exit 1; }
  [ -d "$ROOT/data" ] || { c_yellow "no data/ to push"; return; }
  require_rclone

  local tmp_archive; tmp_archive="$(mktemp /tmp/dst-save-XXXXXX.tar.gz)"
  local archive; archive="$(remote_archive "$b")"

  c_blue "Compressing save data…"
  ( cd "$ROOT" && tar -czf "$tmp_archive" "${TAR_EXCLUDES[@]}" data/ )
  local size; size="$(du -sh "$tmp_archive" | cut -f1)"
  c_blue "Uploading $size → $archive"

  # Keep previous version as .bak before overwriting
  if rclone lsf "$REMOTE" --include "$b.tar.gz" 2>/dev/null | grep -q .; then
    rclone moveto "$archive" "$REMOTE/$b.bak.tar.gz" 2>/dev/null || true
  fi

  rclone copyto "$tmp_archive" "$archive"
  rm -f "$tmp_archive"
  c_green "Pushed ($size)."
}

cmd_pull() {
  local b="${1:?usage: dst pull <branch>}"
  require_rclone

  local archive; archive="$(remote_archive "$b")"
  if ! rclone lsf "$REMOTE" --include "$b.tar.gz" 2>/dev/null | grep -q .; then
    c_yellow "no cloud save for '$b' yet — starting fresh world"
    mkdir -p "$ROOT/data/Master" "$ROOT/data/Caves"
    return
  fi

  local tmp_archive; tmp_archive="$(mktemp /tmp/dst-save-XXXXXX.tar.gz)"
  local size; size="$(rclone size "$archive" 2>/dev/null | grep 'Total size' | awk '{print $3, $4}' || echo '?')"
  c_blue "Downloading $size from $archive"
  rclone copyto "$archive" "$tmp_archive"

  # Extract into temp dir, swap only on success
  local tmp_dir; tmp_dir="$(mktemp -d "$ROOT/.data-pull-XXXXXX")"
  if tar -xzf "$tmp_archive" -C "$tmp_dir"; then
    rm -rf "$ROOT/data/Master" "$ROOT/data/Caves"
    mv "$tmp_dir/data/Master" "$ROOT/data/Master" 2>/dev/null || mkdir -p "$ROOT/data/Master"
    mv "$tmp_dir/data/Caves"  "$ROOT/data/Caves"  2>/dev/null || mkdir -p "$ROOT/data/Caves"
    rm -rf "$tmp_dir" "$tmp_archive"
    c_green "Pulled."
  else
    rm -rf "$tmp_dir" "$tmp_archive"
    c_red "Extract failed — local data untouched. Aborting."
    exit 1
  fi
}

cmd_start() {
  in_repo
  local b="${1:-$(current_state)}"
  [ -n "$b" ] || b="$(current_branch)"
  [ -f "$ENV_FILE" ] || cmd_init
  if [ ! -d "$ROOT/data/Master" ] || [ -z "$(ls -A "$ROOT/data/Master" 2>/dev/null)" ]; then
    if rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
      cmd_pull "$b"
    else
      mkdir -p "$ROOT/data/Master" "$ROOT/data/Caves"
    fi
  fi
  echo "$b" > "$STATE_FILE"
  c_blue "Starting $b"
  compose "$b" up -d
  c_green "Containers up — waiting for game to be playable…"
  if wait_for_ready "$b"; then
    notify 3066993 "🟢 Server ready" "World: \`$b\` is online and accepting players."
  else
    notify 16776960 "⏳ Containers up — ready check timed out" "World: \`$b\` containers are running but cross-shard sync didn't complete within timeout. Server may finish loading on its own; check \`docker logs dst-master-$b\` if it doesn't."
  fi
}

cmd_stop() {
  local b="${1:-$(current_state)}"
  [ -n "$b" ] || { c_yellow "nothing to stop"; return; }
  c_blue "Stopping $b"
  compose "$b" down
  if rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
    cmd_push "$b"
    rm -rf "$ROOT/data/Master" "$ROOT/data/Caves"
    c_green "Save pushed and cleared from VPS."
    clear_orphan_volumes
  else
    c_yellow "rclone not configured — data left in ./data/"
  fi
  notify 15158332 "🔴 Server stopped" "World: \`$b\` is offline. Save uploaded to Drive."
}

cmd_switch() {
  local target="${1:?usage: dst switch <branch>}"
  in_repo
  require_clean_tree

  git_q fetch --quiet origin || c_yellow "git fetch failed (continuing)"

  if ! git_q rev-parse --verify --quiet "$target" >/dev/null; then
    if git_q rev-parse --verify --quiet "origin/$target" >/dev/null; then
      git_q checkout -t "origin/$target"
    else
      c_red "branch '$target' not found locally or on origin"; exit 1
    fi
  fi

  local cur; cur="$(current_state)"
  if [ -n "$cur" ] && is_running "$cur"; then
    c_blue "Stopping current: $cur"
    compose "$cur" down
    if rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
      cmd_push "$cur"
    else
      c_yellow "rclone not configured — skipping push"
    fi
  fi

  clear_orphan_volumes

  c_blue "git checkout $target"
  git_q checkout "$target"
  git_q pull --ff-only origin "$target" 2>/dev/null || c_yellow "git pull skipped"

  rm -rf "$ROOT/data/Master" "$ROOT/data/Caves"
  if rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
    cmd_pull "$target"
  else
    mkdir -p "$ROOT/data/Master" "$ROOT/data/Caves"
  fi

  cmd_init
  cmd_start "$target"
  notify 3447003 "🔄 World switched" "Now running: \`$target\`"
}

cmd_status() {
  local cb cs running=false
  cb="$(current_branch 2>/dev/null || echo '')"
  cs="$(current_state)"
  [ -n "$cs" ] && is_running && running=true

  if [ "$JSON" = 1 ]; then
    local master="" caves=""
    if [ -n "$cs" ]; then
      master="$(docker ps --filter "name=dst-master-$cs" --format '{{.Status}}' || true)"
      caves="$(docker ps --filter "name=dst-caves-$cs" --format '{{.Status}}' || true)"
    fi
    printf '{"branch":"%s","active_world":"%s","running":%s,"master_status":"%s","caves_status":"%s"}\n' \
      "$cb" "$cs" "$running" "$master" "$caves"
    return
  fi

  echo "branch (checked-out): ${cb:-?}"
  echo "world (active):       ${cs:-(none)}"
  if $running; then
    c_green "containers: running"
    docker ps --filter "name=dst-master-$cs" --format '  {{.Names}}\t{{.Status}}'
    docker ps --filter "name=dst-caves-$cs" --format '  {{.Names}}\t{{.Status}}'
  else
    c_yellow "containers: not running"
  fi
}

cmd_restart() {
  in_repo
  local fresh=0 force=0 b=""
  for a in "$@"; do
    case "$a" in
      --fresh|--recreate) fresh=1 ;;
      --force|-y) force=1 ;;
      *) b="$a" ;;
    esac
  done
  b="${b:-$(current_state)}"
  [ -n "$b" ] || { c_red "no active world to restart"; exit 1; }
  [ -f "$ENV_FILE" ] || { c_red ".world.env missing — run 'dst init' first"; exit 1; }

  # Chặn restart khi còn người đang chơi. Người ở dưới Caves lúc restart sẽ bị
  # ghim vào shard đó và không vào lại được (phải chạy 'dst unstick' để gỡ).
  if [ "$force" != 1 ]; then
    local online; online="$(online_players "$b")"
    if [ -n "$online" ]; then
      c_red "Đang có $(echo "$online" | wc -l | tr -d ' ') người chơi online:"
      echo "$online" | sed 's/^/    /'
      c_yellow "Restart lúc này sẽ làm người đang ở dưới hang không vào lại được."
      c_yellow "Bảo họ lên mặt đất và thoát ra, hoặc chạy lại với --force nếu vẫn muốn."
      exit 1
    fi
  fi
  if [ "$fresh" = 1 ]; then
    # Full recreate: needed when .world.env / compose ENV changed (mod LIST, cluster name).
    # Re-downloads any mods missing from the workshop cache volume.
    c_blue "Restarting $b (--fresh: recreate containers, apply env/compose changes)"
    compose "$b" down
    compose "$b" up -d
  else
    # In-place restart: reuses containers → mod cache persists, so the image's
    # 22-mods.sh only re-downloads mods that actually changed (fast). Re-renders
    # modoverrides.lua too. Does NOT apply .world.env/compose ENV changes — use --fresh for those.
    c_blue "Restarting $b in place (keeps mod cache → only changed mods update; applies modoverrides changes)"
    compose "$b" restart
  fi
  c_green "Containers up — waiting for game to be playable…"
  if wait_for_ready "$b"; then
    notify 16776960 "🔄 Server restarted" "World: \`$b\` is back online and accepting players."
  else
    notify 16776960 "⏳ Restart: ready check timed out" "World: \`$b\` containers restarted but cross-shard sync didn't complete within timeout. Check \`docker logs dst-master-$b\`."
  fi
}

# ── mod list helpers ──────────────────────────────────────────────────────────
# modoverrides.lua is the single source of truth for which mods are enabled.
# DST_SERVER_MOD_SETUP (in compose + .world.env) is derived from it.
mods_from_modoverrides() {
  local f="$ROOT/server/config/Master/modoverrides.lua"
  [ -f "$f" ] || return 1
  grep -oE '"workshop-[0-9]+"' "$f" | grep -oE '[0-9]+' | sort -u | paste -sd,
}

# World-content mods: removing one from a LIVE world strips its entities
# (items/buildings) permanently. Only safe to remove on a fresh world.
WORLD_CONTENT_MODS="2334209327 1467214795 3435352667 3360553731 3004639365 3675508496 3353852416 1595631294 2039181790"

cmd_sync_mods() {
  in_repo
  local mods; mods="$(mods_from_modoverrides)" || { c_red "server/config/Master/modoverrides.lua not found"; exit 1; }
  [ -n "$mods" ] || { c_red "no mods found in modoverrides.lua"; exit 1; }
  # Warn if the two shards' modoverrides differ (they must match)
  if ! diff -q "$ROOT/server/config/Master/modoverrides.lua" "$ROOT/server/config/Caves/modoverrides.lua" >/dev/null 2>&1; then
    c_yellow "WARNING: Master and Caves modoverrides.lua differ — they should be identical."
  fi
  [ -f "$SERVER_COMPOSE" ] && sed -i -E "s|(DST_SERVER_MOD_SETUP: )\".*\"|\1\"$mods\"|" "$SERVER_COMPOSE"
  [ -f "$ENV_FILE" ]       && sed -i -E "s|^(DST_SERVER_MOD_SETUP=).*|\1$mods|" "$ENV_FILE"
  c_green "Synced mod list ($(echo "$mods" | tr ',' '\n' | wc -l) mods) from modoverrides → compose + .world.env"
}

cmd_mod() {
  in_repo
  local action="${1:-}" id="${2:-}"
  case "$action" in
    list)
      mods_from_modoverrides | tr ',' '\n' | sed 's/^/  workshop-/'
      return ;;
    add)
      [ -n "$id" ] || { c_red "usage: dst mod add <workshop_id>"; exit 1; }
      for f in Master Caves; do
        local mo="$ROOT/server/config/$f/modoverrides.lua"
        grep -q "\"workshop-$id\"" "$mo" && { c_yellow "$f: workshop-$id already present"; continue; }
        # insert after the opening 'return {'
        sed -i "0,/^return {/s//return {\n  [\"workshop-$id\"]={ configuration_options={  }, enabled=true },/" "$mo"
        c_green "$f: added workshop-$id (empty config)"
      done
      cmd_sync_mods
      c_yellow "Edit configuration_options in modoverrides if needed, then: dst restart --fresh"
      ;;
    remove)
      [ -n "$id" ] || { c_red "usage: dst mod remove <workshop_id>"; exit 1; }
      if echo "$WORLD_CONTENT_MODS" | grep -qw "$id" && is_running; then
        c_red "REFUSED: workshop-$id is a WORLD-CONTENT mod. Removing it from a live world"
        c_red "strips its entities (items/buildings) permanently — only safe on a fresh world."
        c_yellow "If you really mean it: 'dst reset' (fresh world) after removing, or re-add it."
        exit 1
      fi
      for f in Master Caves; do
        local mo="$ROOT/server/config/$f/modoverrides.lua"
        awk -v id="$id" '
          $0 ~ "\\[\"workshop-" id "\"\\]=\\{" {skip=1}
          skip && /^  },$/ {skip=0; next}
          !skip {print}
        ' "$mo" > "$mo.tmp" && mv "$mo.tmp" "$mo"
        c_green "$f: removed workshop-$id"
      done
      cmd_sync_mods
      c_yellow "Apply with: dst restart --fresh"
      ;;
    *) c_red "usage: dst mod <add|remove|list> [workshop_id]"; exit 1 ;;
  esac
}

# Roll the world back N autosave snapshots (≈ N in-game days). Kills (no save) so the
# current state isn't written over the snapshot, moves the latest N world snapshots aside
# (recoverable under data/.rollback-aside-*), then restarts in place. Both shards stay in sync.
cmd_rollback() {
  in_repo
  local n="${1:-1}" b; b="$(current_state)"
  [ -n "$b" ] || { c_red "no active world"; exit 1; }
  case "$n" in (*[!0-9]*|'') c_red "usage: dst rollback [N]  (N = snapshots/days back, default 1)"; exit 1 ;; esac
  local aside="$ROOT/data/.rollback-aside-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$aside"
  c_yellow "Rolling back $n snapshot(s) (~$n in-game day(s)). Killing server (no save-over)…"
  compose "$b" kill 2>/dev/null || true
  local shard ses moved=0
  for shard in Master Caves; do
    ses="$(ls -d "$ROOT/data/$shard/server/general/$shard/save/session/"*/ 2>/dev/null | head -1)"
    [ -n "$ses" ] || { c_yellow "$shard: no session found, skipping"; continue; }
    local latest
    for latest in $(ls -1 "$ses" 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -n "$n"); do
      mv "$ses/$latest" "$ses/$latest.meta" "$aside/$shard-$latest" 2>/dev/null \
        || { for x in "$ses/$latest" "$ses/$latest.meta"; do [ -e "$x" ] && mv "$x" "$aside/$shard-$(basename "$x")"; done; }
      moved=$((moved+1))
    done
    c_green "$shard now loads snapshot $(ls -1 "$ses" | grep -E '^[0-9]+$' | sort -n | tail -1)"
  done
  [ "$moved" -gt 0 ] || { c_red "no snapshots moved — aborting (server left stopped)"; exit 1; }
  c_blue "Restarting in place…"
  compose "$b" start
  wait_for_ready "$b" || true
  c_green "Rolled back. Recoverable from: $aside"
  notify 16753920 "⏪ World rolled back" "World: \`$b\` rolled back ~$n day(s). Backup: $(basename "$aside")"
}

# Gỡ kẹt người chơi bị ghim ở Caves sau khi restart server.
#
# Triệu chứng: ai đó đang ở dưới hang lúc server restart → sau đó không vào lại
# được (kẹt ở màn kết nối, hoặc bị đá ra).
#
# Cơ chế: Master ghi một file 'savelocation' cho biết người chơi đang ở shard
# nào. Restart làm hai shard lệch nhau, Master vẫn đẩy người chơi sang Caves
# trong khi phía Caves không còn phiên tương ứng. Xoá savelocation là Master
# quên chuyện đó và cho họ vào lại ở mặt đất.
#
# Đánh đổi: người chơi quay lại trên mặt đất, không phải chỗ cũ dưới hang.
cmd_unstick() {
  in_repo
  local b; b="$(current_state)"
  [ -n "$b" ] || { c_red "no active world"; exit 1; }
  local SESS=/var/lib/game/server/general/Master/save/session
  c_yellow "Đang tìm savelocation trong world '$b'…"
  local found
  found="$(compose "$b" exec -T master find "$SESS" -name savelocation 2>/dev/null || true)"
  if [ -z "$found" ]; then
    c_green "Không có savelocation nào — không ai bị ghim ở Caves."
    c_yellow "Lỗi vào server lần này do nguyên nhân khác; xem 'dst status' và log."
    exit 0
  fi
  echo "$found" | sed 's/^/  /'
  compose "$b" exec -T master find "$SESS" -name savelocation -delete
  c_blue "Đã xoá. Khởi động lại Master…"
  compose "$b" restart master
  wait_for_ready "$b" || true
  c_green "Xong — người chơi kẹt dưới hang giờ vào lại được, xuất hiện trên mặt đất."
  notify 16753920 "🔓 Gỡ kẹt shard" "World: \`$b\` — đã xoá savelocation và restart Master."
}

cmd_reset() {
  in_repo
  local b="${1:-$(current_state)}"
  [ -n "$b" ] || b="$(current_branch)"
  [ -n "$b" ] || { c_red "no world to reset"; exit 1; }
  [ -f "$ENV_FILE" ] || cmd_init

  c_yellow "Resetting world '$b' — current save will be archived to Drive as ${b}.pre-reset.tar.gz"

  if is_running "$b"; then
    c_blue "Stopping $b"
    compose "$b" stop   # stop (not down) → keep container → mods stay cached → fast fresh world
  fi

  if rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
    if [ -d "$ROOT/data/Master" ] && [ -n "$(ls -A "$ROOT/data/Master" 2>/dev/null)" ]; then
      c_blue "Archiving current save as ${b}.pre-reset.tar.gz…"
      local tmp; tmp="$(mktemp /tmp/dst-pre-reset-XXXXXX.tar.gz)"
      ( cd "$ROOT" && tar -czf "$tmp" "${TAR_EXCLUDES[@]}" data/ )
      rclone copyto "$tmp" "$REMOTE/$b.pre-reset.tar.gz"
      rm -f "$tmp"
      c_green "Archived."
    fi
    if rclone lsf "$REMOTE" --include "$b.tar.gz" 2>/dev/null | grep -q .; then
      rclone delete "$REMOTE/$b.tar.gz"
      c_green "Removed live Drive save: $b.tar.gz"
    fi
  else
    c_yellow "rclone not configured — skipping Drive backup/cleanup"
  fi

  rm -rf "$ROOT/data/Master" "$ROOT/data/Caves"
  mkdir -p "$ROOT/data/Master" "$ROOT/data/Caves"
  c_green "Cleared local save data — fresh world will generate on start"
  clear_orphan_volumes

  cmd_start "$b"
  notify 16753920 "🌍 World reset" "World: \`$b\` reset. Old save archived as \`$b.pre-reset.tar.gz\` on Drive (recoverable)."
}

cmd_destroy() {
  in_repo
  local b; b="$(current_state)"

  # Stop and push if running
  if [ -n "$b" ] && is_running "$b"; then
    c_blue "Stopping $b before destroy"
    compose "$b" down
    if rclone listremotes 2>/dev/null | grep -q "^${REMOTE%%:*}:"; then
      cmd_push "$b"
    fi
  fi

  # Clear local save data
  rm -rf "$ROOT/data/Master" "$ROOT/data/Caves"
  c_green "Cleared ./data/"

  # Remove DST containers (any leftover stopped ones)
  local containers
  containers="$(docker ps -a --format '{{.Names}}' | grep -E '^dst-(master|caves)-' || true)"
  if [ -n "$containers" ]; then
    echo "$containers" | xargs docker rm -f 2>/dev/null || true
    c_green "Removed containers: $(echo "$containers" | tr '\n' ' ')"
  fi

  # Remove DST images (locally-built dst-server, plus published kimdat546/dst-server tags)
  local images
  images="$(docker images --format '{{.Repository}}:{{.Tag}}' | grep -E '^(dst-server|kimdat546/dst-server):' || true)"
  if [ -n "$images" ]; then
    echo "$images" | xargs docker rmi -f 2>/dev/null || true
    c_green "Removed images: $(echo "$images" | tr '\n' ' ')"
  fi

  # Remove leftover named DST volumes
  local volumes
  volumes="$(docker volume ls -q | grep -E '^dst-server-docker_dst-(master|caves)-' || true)"
  if [ -n "$volumes" ]; then
    echo "$volumes" | xargs docker volume rm 2>/dev/null || true
    c_green "Removed volumes: $(echo "$volumes" | tr '\n' ' ')"
  fi

  # Clear state files
  rm -f "$STATE_FILE" "$ENV_FILE"

  notify 10038562 "💣 Server destroyed" "All DST containers, images and local data removed. Drive save intact."
  c_green "Done. Run 'dst start' to rebuild and run again."
}

LUA_DIR="$CLI/lua"
PREFAB_FILE="$LUA_DIR/cleanup_prefabs.txt"

# PID của TIẾN TRÌNH GAME bên trong container. Không dùng .State.Pid được vì đó
# là tini (init của container), không phải server — ghi vào stdin của tini là vô ích.
game_pid() { docker top "$1" -eo pid,comm 2>/dev/null | awk '/dontstarve/ {print $1; exit}'; }

# Gửi một dòng Lua vào server đang chạy, qua stdin của tiến trình game.
# Server dedicated đọc stdin và thực thi TỪNG DÒNG như một chunk Lua riêng —
# nên payload bắt buộc phải nằm gọn trên một dòng.
console_send() {
  local container="$1" lua="$2"
  docker inspect "$container" >/dev/null 2>&1 || { c_red "không có container $container"; return 1; }
  if [ "$(docker inspect -f '{{.Config.OpenStdin}}' "$container")" != "true" ]; then
    c_red "$container chưa mở stdin — không gửi lệnh vào được."
    c_yellow "compose.yml đã bật stdin_open, nhưng phải TẠO LẠI container mới có hiệu lực:"
    c_yellow "  dst restart --fresh     (dừng người chơi vài phút)"
    return 1
  fi
  local pid; pid="$(game_pid "$container")"
  [ -n "$pid" ] || { c_red "không thấy tiến trình game trong $container"; return 1; }
  printf '%s\n' "$lua" > "/proc/$pid/fd/0"
}

cmd_console() {
  in_repo
  local b; b="$(current_state)"; [ -n "$b" ] || { c_red "no active world"; exit 1; }
  local shard=master
  [ "${1:-}" = "--caves" ] && { shard=caves; shift; }
  local lua="${*:-}"
  [ -n "$lua" ] || { c_red "cần đoạn Lua, ví dụ: dst console 'print(#AllPlayers)'"; exit 1; }
  local container="dst-${shard}-${b}" since; since="$(date -Iseconds)"
  console_send "$container" "$lua" || exit 1
  sleep 2
  docker logs --since "$since" "$container" 2>&1 | tail -20 | sed 's/^/  /'
}

# Dọn vật phẩm rác NẰM TRÊN MẶT ĐẤT. Mặc định chỉ ĐẾM THỬ, không xoá.
# Đồ trong rương/balo/Chester và rương của mod Đăng Tiên không bao giờ bị đụng —
# xem phần giải thích vị từ an toàn ở đầu cli/lua/cleanup_ground.lua.
cmd_cleanup() {
  in_repo
  local b; b="$(current_state)"; [ -n "$b" ] || { c_red "no active world"; exit 1; }
  local apply=0 shards="master" prefabs="" show=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --apply)     apply=1 ;;
      --caves)     shards="caves" ;;
      --both)      shards="master caves" ;;
      --list)      show=1 ;;
      --prefabs=*) prefabs="${1#--prefabs=}" ;;
      *) c_red "tuỳ chọn lạ: $1"; exit 1 ;;
    esac
    shift
  done

  # Danh sách lấy từ cli/lua/cleanup_prefabs.txt, trừ khi có --prefabs.
  # Không có file thì rơi về danh sách mặc định nằm sẵn trong script Lua.
  local src="mặc định trong script"
  if [ -z "$prefabs" ] && [ -f "$PREFAB_FILE" ]; then
    prefabs="$(sed 's/#.*//' "$PREFAB_FILE" | tr -d ' \t' | grep -vE '^$' | paste -sd, -)"
    src="$PREFAB_FILE"
  elif [ -n "$prefabs" ]; then
    src="--prefabs trên dòng lệnh"
  fi

  if [ "$show" = 1 ]; then
    c_blue "Nguồn danh sách: $src"
    echo "${prefabs:-twigs,log,charcoal,cutgrass,petals,ash,spoiled_food}" | tr ',' '\n' | sed 's/^/  /'
    return 0
  fi

  local script="$LUA_DIR/cleanup_ground.lua"
  [ -f "$script" ] || { c_red "thiếu $script"; exit 1; }
  # Gộp về một dòng: bỏ dòng chú thích + dòng trống rồi nối. An toàn vì mọi câu
  # lệnh trong file đều kết thúc bằng ';' và không có '--' nào nằm trong chuỗi.
  local body; body="$(grep -vE '^\s*--' "$script" | grep -vE '^\s*$' | tr '\n' ' ')"
  local cfg="CLEANUP_APPLY=$([ $apply -eq 1 ] && echo true || echo false); "
  [ -n "$prefabs" ] && cfg="${cfg}CLEANUP_PREFABS=\"$prefabs\"; "

  if [ $apply -eq 1 ]; then
    c_yellow "Sắp XOÁ VĨNH VIỄN vật phẩm trên mặt đất — world '$b', shard: $shards"
    c_yellow "  danh sách (${src}):"
    echo "${prefabs:-twigs,log,charcoal,cutgrass,petals,ash,spoiled_food}" | tr ',' '\n' | sed 's/^/      /'
    c_yellow "  đồ trong rương/balo KHÔNG bị đụng. Lỡ tay thì 'dst rollback 1' lấy lại được."
    local who; who="$(online_players "$b" || true)"
    [ -n "$who" ] && c_yellow "  đang online: $(echo "$who" | tr '\n' ' ')"
    printf "Gõ 'xoa' để xác nhận: "; local ans; read -r ans
    [ "$ans" = "xoa" ] || { c_yellow "Đã huỷ, không xoá gì."; exit 0; }
  fi

  local s
  for s in $shards; do
    local container="dst-${s}-${b}" since; since="$(date -Iseconds)"
    c_blue "→ $s"
    console_send "$container" "do ${cfg}${body} end" || exit 1
    sleep 2
    docker logs --since "$since" "$container" 2>&1 | grep -a '\[CLEANUP\]' | sed 's/^/    /' \
      || c_yellow "    (chưa thấy phản hồi — kiểm tra: docker logs $container)"
  done
  [ $apply -eq 0 ] && c_yellow "Đây mới là chạy thử. Thêm --apply để xoá thật."
  return 0
}

cmd_help() {
  cat <<'EOF'
dst — branch-as-world manager (git + Google Drive)

Commands:
  dst list                   list branches + cloud saves
  dst status                 current branch / world / container state
  dst current                print active world name
  dst init                   regenerate .world.env from current branch's compose
  dst start  [branch]        pull save from Drive → start containers
  dst stop   [branch]        stop containers → push save to Drive → clear VPS
  dst restart [branch]       fast in-place restart (only changed mods re-download)
  dst restart --force        restart even if players are online (skips the guard)
  dst restart --fresh        recreate containers (apply env/compose/mod-list changes)
  dst rollback [N]           roll world back N autosave snapshots (~N days), recoverable
  dst unstick                unstick players trapped in Caves after a restart
  dst reset  [branch]        archive current save → wipe → start fresh world (recoverable)
  dst switch <branch>        stop+push current → checkout → pull → start
  dst mod add|remove|list [id]  edit enabled mods (both shards) + sync; guards world-content mods
  dst sync-mods              rewrite DST_SERVER_MOD_SETUP from modoverrides (single source of truth)
  dst token list|use|add|rm  đổi token Klei dùng để host. Token nằm trong tokens.env
                             ở gốc repo (KHÔNG vào git, dùng chung mọi world).
                               dst token add cu  'pds-...'   lưu thêm một token
                               dst token use cu              chuyển sang dùng nó
                             Đổi xong phải: dst restart --fresh
  dst push   [branch]        compress & upload save to Drive
  dst pull   <branch>        download & extract save from Drive
  dst destroy                stop+push, remove containers/image/volumes, clear VPS
  dst console [--caves] '<lua>'  run a Lua line on the live server, print the reply
  dst cleanup [--apply] [--caves|--both] [--prefabs=a,b] [--list]
                             dọn vật phẩm rác TRÊN MẶT ĐẤT; mặc định chỉ đếm thử.
                             Đồ trong rương/balo/rương mod không bao giờ bị xoá.
                             Danh sách prefab đọc từ cli/lua/cleanup_prefabs.txt
                             (sửa file đó là đổi được, không cần sửa code).
                             --list in ra danh sách đang dùng rồi thoát.

Notes:
  • Lag in DST = single-thread CPU (mods/entities), NOT RAM — adding swap won't fix lag.
  • console/cleanup cần stdin_open → chạy `dst restart --fresh` MỘT LẦN để tạo lại container.
  • Removing a world-content mod from a live world deletes its items/buildings — fresh world only.

Env:
  DST_REMOTE   rclone target  (default: dst-storage:dst-worlds)
EOF
}

# Parse global flags
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --) shift; break ;;
    -*) break ;;
    *)  break ;;
  esac
done

# cleanup sửa đổi thế giới → phải giữ lock, tránh chạy đè lên dst restart/switch.
# console chỉ đọc trong đa số trường hợp nên không khoá, khỏi chặn lúc chẩn đoán.
LOCKED_CMDS_RE='^(start|stop|restart|reset|switch|push|pull|init|destroy|rollback|unstick|mod|sync-mods|cleanup|token)$'
LOCK_INFO="${LOCK_FILE}.info"
cmd="${1:-help}"; shift || true

if [[ "$cmd" =~ $LOCKED_CMDS_RE ]]; then
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    if [ -f "$LOCK_INFO" ]; then
      local_info="$(cat "$LOCK_INFO" 2>/dev/null || true)"
      c_red "another dst command is running:"
      c_yellow "  $local_info"
      c_red "Try again when it finishes."
    else
      c_red "another dst command is running (lock: $LOCK_FILE). Try again shortly."
    fi
    exit 1
  fi
  # Write metadata while we hold the lock; cleanup on exit.
  printf 'cmd=%s args=%s pid=%s caller=%s started=%s\n' \
    "$cmd" "${*:-}" "$$" "${DST_CALLER:-cli}" "$(date -Iseconds)" > "$LOCK_INFO"
  trap 'rm -f "$LOCK_INFO"' EXIT
fi

case "$cmd" in
  list)    cmd_list ;;
  status)  cmd_status ;;
  current) cmd_current ;;
  init)    cmd_init ;;
  start)   cmd_start "$@" ;;
  stop)    cmd_stop "$@" ;;
  restart) cmd_restart "$@" ;;
  rollback) cmd_rollback "$@" ;;
  unstick) cmd_unstick "$@" ;;
  reset)   cmd_reset "$@" ;;
  switch)  cmd_switch "$@" ;;
  mod)     cmd_mod "$@" ;;
  token)   cmd_token "$@" ;;
  sync-mods) cmd_sync_mods ;;
  push)    cmd_push "$@" ;;
  pull)    cmd_pull "$@" ;;
  destroy) cmd_destroy ;;
  console) cmd_console "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  lock-info) [ -f "$LOCK_INFO" ] && cat "$LOCK_INFO" || echo "no lock held"; exit 0 ;;
  help|-h|--help) cmd_help ;;
  *) c_red "unknown: $cmd"; cmd_help; exit 1 ;;
esac
